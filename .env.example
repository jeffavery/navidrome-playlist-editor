# Host paths. The playlist folder must be inside the music library.
MUSIC_PATH=/path/to/music
PLAYLIST_PATH=/path/to/music/Playlists
# Path from MUSIC_PATH to PLAYLIST_PATH. The default is correct for Music/Playlists.
PLAYLIST_LIBRARY_PATH=Playlists
APP_PORT=8095
RESTART_POLICY=unless-stopped

# Optional. Enables Last.fm favorites and seed-song recommendations.
ND_LASTFM_APIKEY=

